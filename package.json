{
  "name": "visualized-ctrl-c",
  "version": "0.1.0",
  "description": "Tray app that visualizes Ctrl+C clipboard captures with a playful animation.",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "set ELECTRON_BUILDER_CACHE=C:\\\\electron-builder-cache&& set CSC_IDENTITY_AUTO_DISCOVERY=false&& electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^30.0.9",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.example.visualizedctrlc",
    "productName": "Visualized Ctrl C",
    "icon": "assets/icon.png",
    "directories": {
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "overlay.js",
      "package.json",
      "assets/icon.png"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    },
    "win": {
      "sign": false,
      "signingHashAlgorithms": [],
      "executableName": "VisualizedCtrlC",
      "artifactName": "Visualized-Ctrl-C-${version}.${ext}"
    }
  }
}
